# Backend de almacenamiento de medios subidos por el usuario.
# Valores: localforage | minio
VITE_STORAGE_BACKEND=localforage

# Solo necesarios si VITE_STORAGE_BACKEND=minio
VITE_MINIO_ENDPOINT=http://localhost:9000
VITE_MINIO_REGION=us-east-1
VITE_MINIO_BUCKET=mundial-media
VITE_MINIO_ACCESS_KEY=minioadmin
VITE_MINIO_SECRET_KEY=minioadmin
